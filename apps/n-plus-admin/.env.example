NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_MOCKING=enabled

# Deployment environment. Decides which chain the wallet-address and
# transaction-hash columns link to, so it must match the chain the backend at
# NEXT_PUBLIC_API_URL is synced against.
#   development = Ethereum Sepolia
#   production  = Ethereum Mainnet
# Not NODE_ENV: Next.js owns that one and .env cannot override it, which would
# force every built deployment onto mainnet. Unset falls back to Sepolia; any
# other value fails at boot rather than linking to the wrong explorer.
NEXT_PUBLIC_APP_ENV=development
